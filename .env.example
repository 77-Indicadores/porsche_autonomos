# App
APP_ENV=development

# Banco (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=porsche_autonomos

# URL usada pela aplicacao e pelo Alembic
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/porsche_autonomos

# Google Sheets / OAuth (Facilities)
# Cole aqui o conteúdo completo do JSON do cliente OAuth tipo "Web application"
GOOGLE_WEB_CLIENT_JSON={"web":{"client_id":"...","client_secret":"...",...}}
GOOGLE_OAUTH_REDIRECT_URI=https://porshecadastros.77indicadores.com.br/facilities/oauth/callback
# Onde salvar o token após autenticação
GOOGLE_SHEETS_TOKEN_PATH=/etc/porsche/token_google.json

# Catworld (DHO / rel_colab_77)
CATWORLD_URL=https://catworld.77indicadores.com.br
CATWORLD_TOKEN=
CATWORLD_DATASET_ID=eabe09f9-44e2-42e3-8224-c977a9351fe3
# Catworld (Banco de Horas / ifractal_extrato_banco_horas)
CATWORLD_PONTO_DATASET_ID=96737382-05f0-48a6-9b9b-cc0497a0ed3e


# Envio de e-mail (convite de acesso e recuperacao de senha)
# Sem SMTP_HOST, a tela de Usuarios volta a pedir senha digitada.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@77indicadores.com.br
SMTP_PASS=
SMTP_FROM=Sistema Porsche <contato@77indicadores.com.br>
# Endereco publico do sistema. Atras do proxy a aplicacao se enxerga como
# localhost:8000, e sem isto o link do convite chega quebrado no e-mail.
APP_URL=https://porshecadastros.77indicadores.com.br
